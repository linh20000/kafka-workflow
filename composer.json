{
    "name": "kafka/workflow",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "description": "Laravel Kafka package — Transactional Outbox, Relayer, Consumer dispatcher with DLQ/EDL and Telegram alerting.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Linh NQ",
            "email": "linhnq23062000@gmail.com"
        }
    ],
    "require": {
        "flix-tech/avro-php": "^5.1",
        "php": "^8.2",
        "ext-rdkafka": "*",
        "illuminate/console": "^9.0|^10.0|^11.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "illuminate/http": "^9.0|^10.0|^11.0",
        "illuminate/support": "^9.0|^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "mockery/mockery": "^1.6"
    },
    "suggest": {
        "flix-tech/avro-serde-php": "Optional full Avro serde suite (v3.0) with Confluent Schema Registry client. Only needed if you prefer using their registry client directly instead of the built-in HTTP implementation."
    },
    "autoload": {
        "psr-4": {
            "Wf\\Kafka\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Wf\\Kafka\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Wf\\Kafka\\KafkaServiceProvider"
            ],
            "aliases": {
                "WfKafkaProducer": "Wf\\Kafka\\Facades\\KafkaProducer",
                "WfKafkaConsumer": "Wf\\Kafka\\Facades\\KafkaConsumer"
            }
        }
    },
    "scripts": {
        "kafka:install": "bash vendor/wf/kafka/scripts/install-rdkafka.sh",
        "kafka:check":   "bash vendor/wf/kafka/scripts/install-rdkafka.sh --check"
    }
}
